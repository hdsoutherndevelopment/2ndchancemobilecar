# Public site URL (used for canonical URLs, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://2ndchancemobilecar.vercel.app

# --- Optional: enable real quote-form email delivery ---
# Leave these unset and the quote form stays in safe demo mode
# (it validates input and returns a success message without sending anything).
# RESEND_API_KEY=
# QUOTE_TO_EMAIL=
# QUOTE_FROM_EMAIL=
